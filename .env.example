LOG_LEVEL=DEBUG

# Red at container creation
AIRFLOW_UID=1000

# Red at runtime Airflow, through container env
FERNET_KEY=***=

# Client api keys when needed
NEWS_DATA_API_KEY=pub_***
HF_TOKEN=hf_***

# Override per runtime; docker-compose.yaml sets the container value.
PROJECT_ROOT=/path/to/project

# Artifacts path relative to PROJECT_ROOT
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
METRICS_DATA_DIR=data/metrics

# News ingestion db adress
NEWS_DASHBOARD_DATABASE_URL=postgresql://news:news@localhost:5433/news
